generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  userId       String   @unique
  fullName     String
  email        String   @unique
  passwordHash String?
  role         Role
  googleId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}
