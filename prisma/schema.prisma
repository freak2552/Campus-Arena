generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ================================
// USER SYSTEM
// ================================

model User {
  id           Int     @id @default(autoincrement())
  userId       String  @unique
  fullName     String
  email        String  @unique
  passwordHash String?
  role         Role
  googleId     String? @unique

  collegeId Int?
  college   College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)

  studentAcademicProfile StudentAcademicProfile?

  courses  Course[]
  courseEnrollments CourseEnrollment[]
  topicProgress StudentTopicProgress[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ================================
// COLLEGE SYSTEM
// ================================

model College {
  id        Int    @id @default(autoincrement())
  collegeId String @unique

  name    String
  code    String  @unique
  email   String?
  phone   String?
  address String?

  users       User[]
  departments Department[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id   Int    @id @default(autoincrement())
  name String

  collegeId Int
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  studentAcademicProfiles StudentAcademicProfile[]

  programmes Programme[]
  courses    Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([collegeId, name])
  @@index([collegeId])
}

model Programme {
  id   Int    @id @default(autoincrement())
  name String

  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  studentAcademicProfiles StudentAcademicProfile[]

  semesters Semester[]

  courses CourseProgramme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, name])
  @@index([departmentId])
}

model Semester {
  id     Int @id @default(autoincrement())
  number Int

  programmeId Int
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  studentAcademicProfiles StudentAcademicProfile[]

  courses CourseSemester[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programmeId, number])
  @@index([programmeId])
}

// ================================
// ENUMS
// ================================

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseVisibility {
  PRIVATE
  COLLEGE
  PUBLIC
}

enum StudentAccess {
  OPEN
  APPROVAL_REQUIRED
}

enum ContentType {
  TEXT
  VIDEO
  YOUTUBE
  PDF
  ARTICLE
  IMAGE
  FUN_FACT
  GOOD_TO_KNOW
  COMMON_MISTAKE
}

// ================================
// COURSE
// ================================

model Course {
  id          Int     @id @default(autoincrement())
  title       String
  description String?

  category String?
  level    String?
  credits  Int?

  coverUrl String?

  status        CourseStatus     @default(DRAFT)
  visibility    CourseVisibility @default(COLLEGE)
  studentAccess StudentAccess    @default(OPEN)

  // One course belongs to one department
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  // One course can be assigned to multiple programmes
  programmes CourseProgramme[]

  // One course can be assigned to multiple semesters
  semesters CourseSemester[]

  teacherId Int
  teacher   User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules CourseModule[]
  enrollments CourseEnrollment[]

  @@index([teacherId])
  @@index([departmentId])
}

// ================================
// COURSE ↔ PROGRAMME
// ================================

model CourseProgramme {
  courseId    Int
  programmeId Int

  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@id([courseId, programmeId])
  @@index([programmeId])
}

// ================================
// COURSE ↔ SEMESTER
// ================================

model CourseSemester {
  courseId   Int
  semesterId Int

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@id([courseId, semesterId])
  @@index([semesterId])
}

// ================================
// COURSE MODULE
// ================================

model CourseModule {
  id       Int    @id @default(autoincrement())
  title    String
  position Int

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics Topic[]

  @@index([courseId])
}

// ================================
// TOPIC
// ================================

model Topic {
  id       Int    @id @default(autoincrement())
  title    String
  position Int

  moduleId Int
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contentBlocks  ContentBlock[]
  studentProgress StudentTopicProgress[]
  knowledgeCheck KnowledgeCheck?

  @@index([moduleId])
}

// ================================
// CONTENT BLOCK
// ================================

model ContentBlock {
  id       Int         @id @default(autoincrement())
  type     ContentType
  position Int

  content String?
  url     String?

  cloudinaryPublicId     String?
  cloudinaryResourceType String?

  topicId Int
  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topicId])
}

// ================================
// KNOWLEDGE CHECK
// ================================

model KnowledgeCheck {
  id Int @id @default(autoincrement())

  topicId Int   @unique
  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]
}

// ================================
// QUESTION
// ================================

model Question {
  id          Int     @id @default(autoincrement())
  question    String
  explanation String?

  position Int

  knowledgeCheckId Int
  knowledgeCheck   KnowledgeCheck @relation(fields: [knowledgeCheckId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options QuestionOption[]

  @@index([knowledgeCheckId])
}

// ================================
// QUESTION OPTION
// ================================

model QuestionOption {
  id        Int     @id @default(autoincrement())
  text      String
  isCorrect Boolean @default(false)

  position Int

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// ================================
// Student Academic Profile
// ================================

model StudentAcademicProfile {
  id Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  programmeId Int
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  semesterId Int
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([programmeId])
  @@index([semesterId])
}


// ================================
// Student courses profile
// ================================

enum EnrollmentStatus {
  PENDING
  ACTIVE
}

model CourseEnrollment {
  id Int @id @default(autoincrement())

  studentId Int
  student   User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())

  @@unique([studentId, courseId])
  @@index([courseId])
}


// ================================
// Student topic progress
// ================================

model StudentTopicProgress {
  id Int @id @default(autoincrement())

  studentId Int
  student   User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  topicId Int
  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  completedAt DateTime @default(now())

  @@unique([studentId, topicId])
  @@index([topicId])
}