generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  userId       String    @unique
  fullName     String
  email        String    @unique
  passwordHash String?
  role         Role
  googleId     String?   @unique

  collegeId    Int?
  college      College?  @relation(fields: [collegeId], references: [id], onDelete: SetNull)

  sessions     Session[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model College {
  id        Int      @id @default(autoincrement())
  collegeId String   @unique

  name      String
  code      String   @unique
  email     String?
  phone     String?
  address   String?

  users     User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}